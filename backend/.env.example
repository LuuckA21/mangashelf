# Copy to .env and fill in. Never commit .env. Real values live in Bitwarden.
# Spring Boot reads this file locally via spring.config.import (see 03-security-secrets.md).
# Properties format: comments on their own line only, never after a value.

# --- App ---
# dev | staging | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database ---
# Not needed locally: Spring Boot starts backend/compose.yaml and connects to it (10-local-development.md).
# Set these only to use another database:
# DATABASE_URL=jdbc:postgresql://localhost:5432/app
# DATABASE_USER=app
# DATABASE_PASSWORD=

# --- First admin ---
# Created at startup when no user exists yet; the password must be changed at first login.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-locally

# --- Uploads ---
# Where cover images are stored (a mounted volume on the server).
APP_UPLOADS_DIR=./uploads
