# Processato da envsubst all'avvio del container (solo le var MS_*).

# NPM sta su un'altra macchina e parla con noi in HTTP: $scheme qui vale
# sempre "http". Se lo propagassimo, Spring crederebbe di essere servito
# in chiaro e il cookie di sessione con Secure=true verrebbe scartato dal
# browser -> login impossibile. Propaghiamo invece l'header originale di
# NPM, con fallback su $scheme in caso di accesso diretto.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map $http_x_forwarded_host $forwarded_host {
    default $http_x_forwarded_host;
    ""      $host;
}

server {
    listen 80;
    server_name _;

    # Con NPM remoto l'IP sorgente e' sempre quello del proxy: senza
    # questo, ogni log e ogni futuro rate limit vedrebbe un solo client.
    set_real_ip_from ${MS_TRUSTED_PROXY};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Gli asset di Vite hanno l'hash nel nome: cache aggressiva.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Le icone invece hanno nomi fissi: una cache lunga terrebbe in giro la
    # versione vecchia per un anno dopo un cambio di logo.
    location ~* ^/(favicon\.(svg|ico)|apple-touch-icon\.png)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    # L'API viaggia sullo stesso host: niente CORS, il cookie di
    # sessione e' first-party.
    location /api/ {
        proxy_pass http://backend:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Host              $forwarded_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host  $forwarded_host;
        proxy_read_timeout 60s;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
