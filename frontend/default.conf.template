# Processed by envsubst at container startup (MS_* variables only).

# NPM sits on another machine and talks to us over HTTP, so $scheme is
# always "http" here. Propagating it would make Spring believe it is served
# in the clear, and the browser would then drop the Secure session cookie —
# a login that appears to succeed but creates no session. We forward NPM's
# original header instead, falling back to $scheme on direct access.
geo $realip_remote_addr $trusted_proxy_request {
    default 0;
    ${MS_TRUSTED_PROXY} 1;
}

map "$trusted_proxy_request:$http_x_forwarded_proto" $forwarded_proto {
    ~^1:https$ https;
    ~^1:http$  http;
    default    $scheme;
}

map "$trusted_proxy_request:$http_x_forwarded_host" $forwarded_host {
    ~^1:(.+)$ $http_x_forwarded_host;
    default   $host;
}

# Empty keys are not counted. Keep page-load/session requests unrestricted,
# and keep registration separate so it cannot consume the login allowance.
# $binary_remote_addr is evaluated after the real-IP trust boundary below.
map $uri $auth_limit_key {
    default "";
    ~^/api/auth/(login|2fa/login|forgot-password|resend-verification|reset-password)$ $binary_remote_addr;
}
map $uri $registration_limit_key {
    default "";
    /api/auth/register $binary_remote_addr;
}
limit_req_zone $auth_limit_key zone=ms_auth:1m rate=20r/m;
limit_req_zone $registration_limit_key zone=ms_registration:1m rate=5r/m;
limit_req_status 429;

server {
    listen 80;
    server_name _;

    # With NPM on another host the source address is always the proxy's:
    # without this, every log line and any future rate limit would see a
    # single client.
    set_real_ip_from ${MS_TRUSTED_PROXY};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    root /usr/share/nginx/html;
    index index.html;

    # Spring adds these to its own responses, but the SPA and the static
    # files are served by nginx and would otherwise go out bare.
    #
    # Note on inheritance: add_header at this level applies only to blocks
    # that declare no add_header of their own, which is why the one location
    # that needs its own Cache-Control repeats them.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Only AniList's CDN supplies pre-import previews. Stored covers are local.
    # Inline styles are allowed because React writes them as style attributes;
    # scripts have no such exception.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' https://s4.anilist.co data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Vite asset names carry a content hash, so they can be cached hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' https://s4.anilist.co data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    }

    # Covers are content the backend downloaded once and never rewrites for
    # the same id, so they can be cached for a long time. Served from disk
    # rather than proxied: a catalogue page requests one per row.
    location /covers/ {
        alias /usr/share/nginx/covers/;
        expires 30d;
        access_log off;
        # A cover that failed to download leaves no file; answering 404
        # quickly is better than letting the SPA fallback return index.html
        # and have the browser try to decode HTML as an image.
        try_files $uri =404;
    }

    # Icons have fixed names, so a long cache would keep serving the old
    # logo for a year after it changed.
    location ~* ^/(favicon\.(svg|ico)|apple-touch-icon\.png)$ {
        expires 7d;
    }

    # The API is served from the same host: no CORS, and the session cookie
    # stays first-party.
    location /api/ {
        limit_req zone=ms_auth burst=10 nodelay;
        limit_req zone=ms_registration burst=5 nodelay;
        error_page 429 = @auth_rate_limited;
        proxy_pass http://backend:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Host              $forwarded_host;
        proxy_set_header X-Real-IP         $remote_addr;
        # Forward only the address resolved by our explicit trust boundary.
        # Appending client-supplied XFF lets Tomcat reinterpret forged private
        # proxy chains and defeats IP-based abuse limits on direct LAN access.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header Forwarded        "";
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host  $forwarded_host;
        proxy_read_timeout 60s;
    }

    # Leave proxy_intercept_errors off: backend 429 responses retain their
    # endpoint-specific JSON and Retry-After. Only nginx rejections land here.
    location @auth_rate_limited {
        default_type application/json;
        return 429 '{"error":"too_many_attempts"}';
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
