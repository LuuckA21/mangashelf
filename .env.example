# Copy to .env and change the values before the first start.

POSTGRES_DB=mangashelf
POSTGRES_USER=mangashelf
POSTGRES_PASSWORD=cambiami-con-una-password-lunga

# --- Network ------------------------------------------------------
# LAN IP of this Debian server, the one NPM can reach.
# Do not use 0.0.0.0: it would include every other interface.
BIND_ADDRESS=192.168.1.10
HTTP_PORT=8080

# IP (or CIDR) of the host running NPM. nginx trusts its X-Forwarded-*
# headers only when they arrive from here.
TRUSTED_PROXY=192.168.1.2

# --- Application --------------------------------------------------
# Set to false once you have signed up, to close registrations.
APP_REGISTRATION_ENABLED=true

# true because NPM terminates TLS: the browser still speaks HTTPS.
APP_COOKIE_SECURE=true
