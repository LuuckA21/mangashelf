# Copia in .env e cambia i valori prima del primo avvio.

POSTGRES_DB=mangashelf
POSTGRES_USER=mangashelf
POSTGRES_PASSWORD=cambiami-con-una-password-lunga

# --- Rete ---------------------------------------------------------
# IP LAN del server Debian, quello raggiungibile da NPM.
# Non usare 0.0.0.0: includerebbe ogni altra interfaccia.
BIND_ADDRESS=192.168.1.10
HTTP_PORT=8080

# IP (o CIDR) del server dove gira NPM. nginx si fida dei suoi
# header X-Forwarded-* solo se arrivano da qui.
TRUSTED_PROXY=192.168.1.2

# --- Applicazione -------------------------------------------------
# Metti a false dopo esserti registrato, per chiudere le iscrizioni.
APP_REGISTRATION_ENABLED=true

# true perche' NPM termina il TLS: il browser parla comunque HTTPS.
APP_COOKIE_SECURE=true
