# PostgreSQL
POSTGRES_DB=mangashelf
POSTGRES_USER=mangashelf
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional until 2FA is enabled. Generate once: openssl rand -base64 32
# Preserve separately from DB backups; never regenerate during ordinary deploys.
APP_2FA_ENCRYPTION_KEY=

# Application
# Registration is closed by default. Set true only while creating approved accounts,
# then restore false and redeploy immediately.
APP_REGISTRATION_ENABLED=false
# Comma-separated trusted HTTPS hosts from which the backend may fetch covers.
APP_COVERS_ALLOWED_HOSTS=s4.anilist.co
# Keep true behind HTTPS. Use false only for local HTTP development.
APP_COOKIE_SECURE=true

# Network
# LAN address of the server running MangaShelf.
BIND_ADDRESS=192.168.1.20
HTTP_PORT=8080
# IP address or CIDR of the trusted reverse proxy (for example Nginx Proxy Manager).
TRUSTED_PROXY=192.168.1.10/32

# Keeps Docker volume names stable even if the repository directory is renamed.
COMPOSE_PROJECT_NAME=mangashelf

# Email: enable after configuring SMTP. New accounts then require confirmation.
APP_EMAIL_ENABLED=false
APP_PUBLIC_URL=https://manga.example.com
MAIL_FROM=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
