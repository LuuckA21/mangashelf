[Unit]
Description=Create and rotate a verified MangaShelf backup

[Service]
Type=oneshot
WorkingDirectory=%h/mangashelf
Environment="PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/env bash %h/mangashelf/scripts/backup-scheduled.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
